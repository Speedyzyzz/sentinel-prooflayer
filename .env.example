# ==============================================================================
# Sentinel & ProofLayer Environment Configuration Template
# PayPal AI Hackathon 2026
# ==============================================================================

# ------------------------------------------------------------------------------
# PayPal Developer Sandbox Credentials
# Register at: https://developer.paypal.com/dashboard/applications/sandbox
# If left empty or set to "mock", the built-in Deterministic Sandbox Twin activates.
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=WH-99412-DEV-SIMULATED

# ------------------------------------------------------------------------------
# LLM Providers (for Natural Language Mandate Compilation)
# If left empty, deterministic AST/regex rule compiler fallback is used.
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Backend Server & Database Settings
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./sentinel.db
PORT=8000
HOST=0.0.0.0
DEBUG=false
SECRET_KEY=sentinel_secret_key_prod_prooflayer_2026_entropy_seed
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_PAYPAL_ENV=sandbox
